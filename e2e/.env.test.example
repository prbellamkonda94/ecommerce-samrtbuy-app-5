# Copy this file to .env.test and fill in a real value. .env.test is
# gitignored and must never be committed; this .example file is the
# checked-in template.
#
# TEST_DATABASE_URL must point at a database dedicated to this test suite --
# NEVER the app's own dev/prod DATABASE_URL from the project root .env.
# global-setup.ts refuses to run if the two resolve to the same
# host+database, but pick a distinct one up front regardless.
#
# Recommended: a sibling database on the same Neon project/endpoint, e.g.
# swap "neondb" for "neondb_test" in the app's own connection string.
TEST_DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb_test?sslmode=require
