# Copy this file to .env.k6 and fill in a real value. .env.k6 is gitignored
# and must never be committed; this .example file is the checked-in template.
#
# TEST_DATABASE_URL must point at a database dedicated to load testing --
# NEVER the app's own dev/prod DATABASE_URL from the project root .env. Load
# tests generate high-volume write traffic; running them against the real
# database risks corrupting or flooding it.
#
# If this repo already has e2e/.env.test or security/.env.test (from the
# e2e-test-suite-ui-playwright / e2e-code-security-review skills) with their
# own TEST_DATABASE_URL, reuse that same value here rather than provisioning
# a third throwaway database.
TEST_DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb_test?sslmode=require
