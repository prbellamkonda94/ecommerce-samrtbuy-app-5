DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
PORT=3001

# Local observability (OpenTelemetry -> Grafana). Off by default -- see
# "Observability" in CLAUDE.md. To try it: docker compose -f
# docker-compose.otel.yml up -d, then set OTEL_ENABLED=true here.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=smartbuy-api
