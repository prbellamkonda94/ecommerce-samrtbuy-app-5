# Copy this file to .env.test and fill in a real value. .env.test is
# gitignored and must never be committed; this .example file is the
# checked-in template.
#
# TEST_DATABASE_URL must point at a database dedicated to security testing --
# NEVER the app's own dev/prod DATABASE_URL. Dynamic tests intentionally send
# injection payloads and probe access control; lib/db-safety.mjs refuses to
# run if this resolves to the same host+database as the app's own DATABASE_URL,
# but pick a distinct one up front regardless.
#
# If this app already has an e2e/.env.test (from the e2e-test-suite-ui-playwright
# skill) with its own TEST_DATABASE_URL, reuse that same value here rather than
# provisioning a second throwaway database.
TEST_DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb_test?sslmode=require

# Base URL the dynamic test suite will attack. Set by scripts/run-dynamic-tests.mjs
# to point at the isolated port it starts the backend on -- override only if
# you're running dynamic tests against an already-running instance.
# SECURITY_TARGET_URL=http://localhost:8822
